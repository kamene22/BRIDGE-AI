  {
    "test_id": "GE-027",
    "category": "conversational_continuity",
    "question": "What happens if I refuse the extension?",
    "conversation_history": [
      {
        "role": "user",
        "content": "I just started my first job at an NGO in Nairobi. What should I know about probation?"
      },
      {
        "role": "assistant",
        "content": "Probation in Kenya is generally capped at 6 months under the Employment Act. During this period, your employer evaluates your suitability for the role. Make sure your probation terms are clearly stated in your written contract. Key things to know: notice periods during probation are typically shorter, and you should ask about performance review criteria."
      },
      {
        "role": "user",
        "content": "My manager said my probation might be extended to 8 months. Is that legal?"
      },
      {
        "role": "assistant",
        "content": "Under the Employment Act, probation extensions are possible but require your written consent and must be documented. The total probation period including any extension should generally not exceed 12 months. Check your contract for specific extension clauses, and don't agree to an extension verbally \u2014 insist on written documentation."
      }
    ],
    "requires_retrieval": true,
    "expected_source": "bridge_ai_career_handbook_expanded.md",
    "expected_chunk_keywords": [
      "salary",
      "negotiation",
      "market rate",
      "entry level"
    ],
    "required_facts": [
      "research market benchmarks",
      "focus on value and skills"
    ],
    "must_include": [
      "extension",
      "probation"
    ],
    "must_not_include": [
      "What do you mean?",
      "Could you clarify?"
    ]
  },
